# Copy this file to .env and fill in real values. .env itself is gitignored
# and must never be committed -- only this .example file is safe to commit.

# Django's cryptographic signing key. Generate a fresh one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-real-secret-key

# Example of a real or dummy third-party API key the project might use.
CLAIMS_EXTERNAL_API_KEY=replace-with-a-real-or-dummy-key

# Comma-separated list of allowed hosts, used by production settings only.
ALLOWED_HOSTS=your-domain.example.com

# Google Cloud OAuth web client. Configure via environment only; do not also
# create a SocialApp in admin, which would duplicate this provider config.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional absolute SQLite path; keep a live database outside the Git checkout.
# DATABASE_PATH=/home/YOUR_USERNAME/private/claimsense.sqlite3

# A6: Google Gemini API key for appeal letters (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: GEMINI_MODEL=gemini-3.5-flash-lite   GEMINI_HOURLY_LIMIT=10

# A6 notebook only (llm-test/ai_prototype.ipynb): the 7B+ benchmark models run on free-tier APIs.
# Groq: https://console.groq.com/keys  (Gemma 4 models use GEMINI_API_KEY above)
GROQ_API_KEY=
# Optional: a Hugging Face read token gives faster, rate-limit-free weight downloads
HF_TOKEN=

# A6: local model. Set LOCAL_LLM_ENABLED=0 on hosts that cannot run torch (e.g. PythonAnywhere free tier).
# LOCAL_LLM_ENABLED=1
# LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# A9: "Ask about my plan" (retrieval + local model). All optional; defaults shown.
# RAG_EMBEDDINGS_ENABLED=1            # 0 = keyword search fallback (hosts without torch)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_TOP_K=3  RAG_MIN_SCORE=0.25  RAG_FILTER_BY_PLAN=1  RAG_MAX_TOKENS=120  RAG_MAX_SECONDS=60
# LOCAL_LLM_MAX_SECONDS=45
# Where the local LLM runs: cpu (default) | mps (Mac with Apple silicon: much faster) | cuda | auto
# LOCAL_LLM_DEVICE=auto
